# Значения для локального запуска (npm run dev). В docker-compose переменные задаются в docker-compose.yml.
PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=calendar_db
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Число доверенных прокси перед backend. 0 — прокси нет (иначе X-Forwarded-For можно подделать)
TRUST_PROXY=0
# Обязателен, минимум 32 символа: без него сервер не стартует
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Флаг Secure у refresh-cookie (по умолчанию true при NODE_ENV=production). Для http — false
COOKIE_SECURE=false
# Администратор создаётся при первом запуске, только если задан ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
LOG_LEVEL=info
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Calendar App <noreply@calendar.local>
